rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada negócio só é lido/escrito pelo seu próprio dono (uid do login)
    match /negocios/{negocioId} {
      allow read, write: if request.auth != null && request.auth.uid == negocioId;

      match /servicos/{servicoId} {
        allow read, write: if request.auth != null && request.auth.uid == negocioId;
      }
      match /clientes/{clienteId} {
        allow read, write: if request.auth != null && request.auth.uid == negocioId;
      }
      match /marcacoes/{marcacaoId} {
        allow read, write: if request.auth != null && request.auth.uid == negocioId;
      }
      match /vendas/{vendaId} {
        allow read, write: if request.auth != null && request.auth.uid == negocioId;
      }
    }
  }
}
